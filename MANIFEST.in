include README.md LICENSE AGENTS.md pyproject.toml setup.py requirements.txt .github/constraints-release.txt
recursive-include docs *.md *.csv *.json
recursive-include schemas *.json
recursive-include configs *.json
recursive-include tools/acira-capture-extension *.json *.js *.html *.css *.md *.svg
include tools/verify_wheel.py tools/prepare_release.py tools/verify_release_environment.py
include tools/start_release_runner.py tools/configure_ci_chromium.py tools/verify_dependency_audit.py
recursive-include tests *.py
include tools/public_site_sweep.py tools/specific_policy_sweep.py tools/public-sites.json
recursive-include demo *.html *.css *.js
recursive-include skills *.json
prune .acira
prune .pytest_tmp
prune local-runtime
global-exclude __pycache__ *.py[cod] *.secrets.local.json .env
