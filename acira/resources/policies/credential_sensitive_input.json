{
  "schema": "acira.general_skill.v3",
  "id": "acira.general.credential_sensitive_input",
  "name": "Credential And Sensitive Input Protection",
  "version": 2,
  "requires": ["page", "target", "form", "action", "value"],
  "risks": [
    {
      "id": "credential.sensitive_fields_present",
      "context": "page",
      "severity": "medium",
      "description": "Acira detected credential or sensitive input fields on this page.",
      "decisions": [
        "allow",        "ask",
        "block"
      ],
      "detection": {
        "when": [
          "page_preflight",
          "sensitive_fields_on_page"
        ],
        "reason": "Acira detected credential or sensitive input fields on this page."
      }
    },
    {
      "id": "credential.sensitive_input_entry",
      "context": "action",
      "severity": "high",
      "description": "Acira detected entry into a credential or sensitive input field.",
      "decisions": [
        "allow",        "ask",
        "block"
      ],
      "detection": {
        "when": [
          "credential_field",
          "text_entry"
        ],
        "reason": "Acira detected entry into a credential or sensitive input field."
      }
    }
  ],
  "lexicons": {
    "sensitive_identity": ["2fa", "api", "auth", "authentication", "bearer", "credential", "key", "mfa", "otp", "passcode", "password", "private", "recovery", "secret", "sensitive", "token", "vault", "verification", "verify"],
    "sensitive_value_class": ["high_entropy", "otp_like", "token_like"],
    "freeform_note_identity": ["comment", "description", "details", "instructions", "memo", "message", "note", "notes", "remark", "remarks"],
    "safe_text_type": ["email", "search", "url"]
  },
  "rules": {
    "page_preflight": {
      "equals": { "path": "action.action", "value": "page_preflight" }
    },
    "text_entry": {
      "equals": { "path": "action.action", "value": "form_input" }
    },
    "sensitive_autocomplete": {
      "in": {
        "path": "target.attributes.autocomplete",
        "values": ["current-password", "new-password", "one-time-code"]
      }
    },
    "password_type": {
      "equals": { "path": "target.type", "value": "password" }
    },
    "sensitive_tokens": {
      "token_match": {
        "paths": ["target.identity_tokens", "target.nearby_tokens", "target.section_tokens", "target.form_tokens"],
        "lexicon": "sensitive_identity",
        "min_matches": 1,
        "confidence": 0.78
      }
    },
    "sensitive_value": {
      "token_match": {
        "paths": ["value.classes"],
        "lexicon": "sensitive_value_class",
        "min_matches": 1,
        "confidence": 0.78
      }
    },
    "safe_text_type": {
      "in": {
        "path": "target.type",
        "values": ["email", "search", "url"]
      }
    },
    "freeform_note_field": {
      "all": [
        {
          "token_match": {
            "paths": ["target.identity_tokens"],
            "lexicon": "freeform_note_identity",
            "min_matches": 1,
            "confidence": 0.72
          }
        },
        {
          "not": {
            "token_match": {
              "paths": ["target.identity_tokens"],
              "lexicon": "sensitive_identity",
              "min_matches": 1,
              "confidence": 0.72
            }
          }
        }
      ]
    },
    "credential_field": {
      "any": [
        { "rule": "password_type" },
        { "rule": "sensitive_autocomplete" },
        {
          "all": [
            { "equals": { "path": "target.is_editable", "value": true } },
            { "rule": "sensitive_tokens" },
            { "not": { "rule": "safe_text_type" } },
            { "not": { "rule": "freeform_note_field" } }
          ]
        },
        {
          "all": [
            { "equals": { "path": "target.is_form_control", "value": true } },
            { "rule": "sensitive_value" },
            { "not": { "rule": "safe_text_type" } },
            { "not": { "rule": "freeform_note_field" } }
          ]
        }
      ]
    },
    "sensitive_password_controls_on_page": {
      "any_where": {
        "path": "page.controls",
        "where": {
          "all": [
            { "in": { "path": "tag", "values": ["input", "textarea"] } },
            { "equals": { "path": "is_form_control", "value": true } },
            { "equals": { "path": "is_disabled", "value": false } },
            { "equals": { "path": "is_hidden", "value": false } },
            { "equals": { "path": "attributes.type", "value": "password" } }
          ]
        },
        "confidence": 0.96
      }
    },
    "sensitive_autocomplete_controls_on_page": {
      "any_where": {
        "path": "page.controls",
        "where": {
          "all": [
            { "in": { "path": "tag", "values": ["input", "textarea"] } },
            { "equals": { "path": "is_form_control", "value": true } },
            { "equals": { "path": "is_disabled", "value": false } },
            { "equals": { "path": "is_hidden", "value": false } },
            { "in": { "path": "attributes.autocomplete", "values": ["current-password", "new-password", "one-time-code"] } }
          ]
        },
        "confidence": 0.92
      }
    },
    "sensitive_token_controls_on_page": {
      "any_where": {
        "path": "page.controls",
        "where": {
          "all": [
            { "in": { "path": "tag", "values": ["input", "textarea"] } },
            { "equals": { "path": "is_form_control", "value": true } },
            { "equals": { "path": "is_disabled", "value": false } },
            { "equals": { "path": "is_hidden", "value": false } },
            {
              "token_match": {
                "paths": ["identity_tokens", "nearby_tokens", "section_tokens", "form_tokens"],
                "lexicon": "sensitive_identity",
                "min_matches": 1,
                "confidence": 0.78
              }
            },
            {
              "not": {
                "token_match": {
                  "paths": ["identity_tokens"],
                  "lexicon": "safe_text_type",
                  "min_matches": 1
                }
              }
            }
          ]
        },
        "confidence": 0.78
      }
    },
    "sensitive_fields_on_page": {
      "any": [
        { "rule": "sensitive_password_controls_on_page" },
        { "rule": "sensitive_autocomplete_controls_on_page" },
        { "rule": "sensitive_token_controls_on_page" }
      ]
    }
  }}
