{
  "schema": "acira.config.v1",
  "name": "Browser-Use Checkout Demo",
  "agent_name": "browser-use-checkout",
  "enabled": true,
  "dashboard": {
    "connect": true,
    "review_timeout_seconds": 3600
  },
  "terminal_review": true,
  "terminal_log": true,
  "default_review_decision": "ask",
  "probe_timeout": 1.5,
  "hitl_freeze_mode": "off",
  "adapters": {
    "browser_use": { "enabled": true }
  },
  "general_skill_preflight": {
    "enabled": true,
    "quiet_ms": 500,
    "max_wait_ms": 4000,
    "on_error": "block_mutating_until_action_probe"
  },
  "agent_js": { "block_arbitrary": false },
  "specific_skills": [],
  "general_skills": {
    "acira.general.checkout": {
      "path": "../skills/general/checkout.json",
      "risks": {
        "checkout.page_detected": "allow",
        "checkout.payment_flow_detected": "allow",
        "checkout.payment_fields_present": "allow",
        "checkout.payment_submit_present": "allow",
        "checkout.card_data_entry": "allow",
        "checkout.card_expiry_entry": "allow",
        "checkout.card_cvv_entry": "allow",
        "checkout.payment_form_input": "allow",
        "checkout.payment_submit_attempt": "ask"
      }
    },
    "acira.general.destructive_action": {
      "path": "../skills/general/destructive_action.json",
      "risks": {
        "destructive.controls_present": "allow",
        "destructive.action_attempt": "block"
      }
    }
  },
  "audit": { "mode": "volatile" }
}
